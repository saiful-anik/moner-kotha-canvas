{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moner-kotha-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGIN": "http://localhost:5173"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
